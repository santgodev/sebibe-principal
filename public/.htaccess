# Enable Rewrite Engine
RewriteEngine On

# Redirect directly requested .html files to the clean version
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# Serve the .html file internally if it exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# If trailingSlash is true, Next.js generates folder/index.html
# This handles the case where someone visits /folder
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Custom 404 page (if you have one in Next.js)
ErrorDocument 404 /404.html
